{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": {
        "swcrcPath": ".swcrc",
        "extensions": [".ts", ".tsx", ".js", ".jsx"]
      }
    },
    "typeCheck": true,
    "assets": [
      {
        "include": "../../../libs/i18n/src/**/*",
        "outDir": "dist/libs/i18n/src",
        "watchAssets": true
      }
    ]
  },
  "projects": {
    "nestjs-boilerplate-admin": {
      "type": "application",
      "root": "apps/nestjs-boilerplate-admin",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-boilerplate-admin/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-boilerplate-admin/tsconfig.app.json"
      }
    },
    "nestjs-boilerplate-mobile": {
      "type": "application",
      "root": "apps/nestjs-boilerplate-mobile",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-boilerplate-mobile/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-boilerplate-mobile/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "configs": {
      "type": "library",
      "root": "libs/configs",
      "entryFile": "index",
      "sourceRoot": "libs/configs/src",
      "compilerOptions": {
        "tsConfigPath": "libs/configs/tsconfig.lib.json"
      }
    },
    "core": {
      "type": "library",
      "root": "libs/core",
      "entryFile": "index",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    },
    "i18n": {
      "type": "library",
      "root": "libs/i18n",
      "entryFile": "index",
      "sourceRoot": "libs/i18n/src",
      "compilerOptions": {
        "tsConfigPath": "libs/i18n/tsconfig.lib.json"
      }
    }
  }
}