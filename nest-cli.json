{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "i18n/**/*",
        "watchAssets": false
      }
    ],
    "deleteOutDir": true,
    "builder": "tsc",
    "typeCheck": false,
    "watchAssets": false,
    "tsConfigPath": "tsconfig.json",
    "webpack": false
  }
}
