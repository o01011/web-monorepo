{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"compilerOptions": {
		"assets": [
			{
				"include": "i18n/**/*",
				"watchAssets": false
			}
		],
		"builder": "tsc",
		"deleteOutDir": true,
		"tsConfigPath": "tsconfig.json",
		"typeCheck": false,
		"watchAssets": false,
		"webpack": false
	},
	"sourceRoot": "src"
}
