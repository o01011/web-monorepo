{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/nestjs-boilerplate/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/nestjs-boilerplate/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/nestjs-boilerplate",
  "projects": {
    "nestjs-boilerplate": {
      "type": "application",
      "root": "apps/nestjs-boilerplate",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-boilerplate/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-boilerplate/tsconfig.app.json"
      }
    },
    "nestjs-boilerplate-mobile": {
      "type": "application",
      "root": "apps/nestjs-boilerplate-mobile",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-boilerplate-mobile/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-boilerplate-mobile/tsconfig.app.json"
      }
    },
    "initializers": {
      "type": "library",
      "root": "libs/initializers",
      "entryFile": "index",
      "sourceRoot": "libs/initializers/src",
      "compilerOptions": {
        "tsConfigPath": "libs/initializers/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "configs": {
      "type": "library",
      "root": "libs/configs",
      "entryFile": "index",
      "sourceRoot": "libs/configs/src",
      "compilerOptions": {
        "tsConfigPath": "libs/configs/tsconfig.lib.json"
      }
    },
    "i18n": {
      "type": "library",
      "root": "libs/i18n",
      "entryFile": "index",
      "sourceRoot": "libs/i18n/src",
      "compilerOptions": {
        "tsConfigPath": "libs/i18n/tsconfig.lib.json"
      }
    }
  }
}