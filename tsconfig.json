{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true,
    "paths": {
      "@common/*": [
        "src/common/*"
      ],
      "@core/*": [
        "src/core/*"
      ],
      "@modules/users/*": [
        "src/modules/users/*"
      ],
      "@modules/posts/*": [
        "src/modules/posts/*"
      ],
      "@app/initializers": [
        "libs/initializers/src"
      ],
      "@app/initializers/*": [
        "libs/initializers/src/*"
      ],
      "@app/common": [
        "libs/common/src"
      ],
      "@app/common/*": [
        "libs/common/src/*"
      ],
      "@app/configs": [
        "libs/configs/src"
      ],
      "@app/configs/*": [
        "libs/configs/src/*"
      ],
      "@app/i18n": [
        "libs/i18n/src"
      ],
      "@app/i18n/*": [
        "libs/i18n/src/*"
      ]
    }
  }
}