{
  "name": "nestjs-boilerplate",
  "version": "0.0.1",
  "description": "NestJS Boilerplate by maxondev",
  "keywords": [],
  "homepage": "https://github.com/maxonchickdev/nestjs-boilerplate?tab=readme-ov-file#readme",
  "bugs": {
    "url": "https://github.com/maxonchickdev/nestjs-boilerplate/issues",
    "email": "nestjs-boilerplate@gmail.com"
  },
  "author": "maxondev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxonchickdev/nestjs-boilerplate"
  },
  "scripts": {
    "build": "nest build",
    "lint:check": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix -c eslint.config.ts",
    "lint:format:check": "prettier . -c --ignore-path .prettierignore",
    "lint:format:fix": "prettier . -w --ignore-path .prettierignore",
    "lint:filesystem": "ls-lint",
    "lint:clean": "knip",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:docs": "npx @compodoc/compodoc -p tsconfig.json -s",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio --browser none",
    "docker:local:up": "docker compose -f docker-compose.local.yml up -d --no-color --timestamps --wait --wait-timeout 20",
    "docker:local:down": "docker compose -f docker-compose.local.yml down -v",
    "docker:local:start": "docker compose -f docker-compose.local.yml start",
    "docker:local:stop": "docker compose -f docker-compose.local.yml stop -t 10",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --no-color --timestamps --wait --wait-timeout 20",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down -v",
    "docker:prod:start": "docker compose -f docker-compose.prod.yml start",
    "docker:prod:stop": "docker compose -f docker-compose.prod.yml stop -t 10",
    "hooks:init": "simple-git-hooks",
    "hooks:precommit": "concurrently 'npm run lint:filesystem' 'npm run lint:clean' 'npm run lint:check' 'npm run lint:format:check'"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "ioredis": "^5.9.2",
    "joi": "^18.0.2",
    "nestjs-i18n": "^10.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@commitlint/types": "^20.3.1",
    "@compodoc/compodoc": "^1.2.1",
    "@faker-js/faker": "^10.3.0",
    "@ls-lint/ls-lint": "^2.3.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.11",
    "@types/passport-jwt": "^4.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "knip": "^5.82.0",
    "prettier": "^3.4.2",
    "prisma": "^7.2.0",
    "simple-git-hooks": "^2.13.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "os": [
    "darwin",
    "linux",
    "!win32"
  ],
  "engines": {
    "node": "22.22.0",
    "npm": "10.9.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  }
}
