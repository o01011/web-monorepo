NODE_ENV=development

APP_PORT=8000
APP_REQUEST_TIMEOUT=5000
APP_NAME='Nestjs boilerplate'
APP_DESCRIPTION='Nestjs builerplate description'
APP_LOG_LEVEL=7

SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=111

POSTGRES_URL=postgresql://admin:admin@localhost:5432/mydb?schema=public
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=mydb

KAFKA_NODE_ID=1
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_NUM_PARTITIONS=3

KAFKA_UI_PORT=8080
KAFKA_CLUSTERS_0_NAME=local

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_DATABASES=0
REDIS_PASSWORD=111

RI_PORT=5540
RI_DISABLE_ENCRYPTION=1

I18N_FALLBACK_LANGUAGE=nl
